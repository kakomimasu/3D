{
  "nodeModulesDir": "manual",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "tasks": {
    "dev": "deno run -A npm:vite --host 127.0.0.1",
    "typecheck": "deno check src/*.ts vite.config.ts",
    "test": "deno test src/*.test.ts",
    "build": "deno task typecheck && deno run -A npm:vite build"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "types": [
      "vite/client"
    ]
  }
}
